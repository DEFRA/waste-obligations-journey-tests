EPR_BASE_URL=https://localhost:7084
# packaging is the local default; CI uses waste-obligations.
JOURNEY_ENTRY_POINT=packaging
# Optional override for the lifecycle API; inferred from ENVIRONMENT otherwise.
# WASTE_OBLIGATIONS_API_BASE_URL=http://localhost:8007

# CSoC E2E skill — producer side
# Optional: overrides the producer certificate landing URL for E2E-01.x. The
# tst FE mounts the submission directly at this path — set this to skip the
# /report-data/manage-your-recycling-obligations click-through. Placeholders
# {orgId} and {year} are substituted from the matrix entry.
EPR_CERTIFICATE_URL_TEMPLATE=https://packaging-waste-proxy.test.cdp-int.defra.cloud/manage-recycling-obligations/producer/{orgId}/compliance/certificate?year={year}
# unsubmitted-orgs skill: compliance-declarations backend behind the CDP protected
# gateway (include the /waste-obligations prefix). WASTE_OBLIGATIONS_API_BASE_URL
# above takes precedence when both are set. For local, use http://localhost:8007.
WASTE_OBLIGATIONS_BACKEND_URL=https://ephemeral-protected.api.test.cdp-int.defra.cloud/waste-obligations
# Required for the CDP protected gateway (tst/dev). Not needed for local.
# The unsubmitted-orgs skill refuses to start without this when targeting a
# shared env.
WASTE_OBLIGATIONS_API_KEY=replace-me
EPR_USER_EMAIL=replace-me@example.com
EPR_USER_PASSWORD=replace-me
WASTE_OBLIGATION_USERNAME=replace-me
WASTE_OBLIGATION_PASSWORD=replace-me
JOURNEY_USER=replace-me
JOURNEY_PASSWORD=replace-me
WASTE_OBLIGATION_ORG_ID=replace-me
WASTE_OBLIGATION_SUBMITTER_ID=replace-me
WASTE_OBLIGATION_SUBMITTER_EMAIL=replace-me@example.com

# CSO account (used when ACCOUNT=cso)
EPR_CSO_USER_EMAIL=replace-me@example.com
EPR_CSO_USER_PASSWORD=replace-me
WASTE_OBLIGATION_CSO_ORG_ID=replace-me

# Optional client-credentials auth: set all three to use Bearer instead of Basic.
# For local access to CDP dev, also set WASTE_OBLIGATIONS_API_BASE_URL to
# https://waste-obligations.api.dev.cdp-int.defra.cloud
WASTE_OBLIGATIONS_API_TOKEN_URL=
WASTE_OBLIGATIONS_API_CLIENT_ID=
WASTE_OBLIGATIONS_API_CLIENT_SECRET=

# Required for PRNs, cookie banner and GA journeys with JOURNEY_ENTRY_POINT=packaging,
# including CDP Portal runs against deployed Azure/CDP.
# Public packaging-waste-proxy URL including the routing prefix.
# WASTE_OBLIGATIONS_FRONTEND_BASE_URL=https://packaging-waste-proxy.dev.cdp-int.defra.cloud/manage-recycling-obligations/

# Optional expected flags for Portal-style runs. Explicit false skips that
# journey. Unset or true means the feature must be present; a missing page or
# tile fails the test. FEATURE_MANAGE_OBLIGATIONS is recorded for alignment
# only and does not skip CSOC.
# FEATURE_SHOW_PRNS is the Waste Obligations frontend flag for CDP PRNs pages.
# FEATURE_SHOW_PRNS_ON_CDP is Packaging FeatureManagement__ShowPrnsOnCdp.
# Enable both together to connect the apps and show PRNs.
# FEATURE_SHOW_PRNS=false
# FEATURE_SHOW_PRNS_ON_CDP=false
# FEATURE_MANAGE_OBLIGATIONS=true
# FEATURE_CSOC_ENABLED=true
# FEATURE_SHOW_MULTI_YEAR_OBLIGATIONS=false
# FEATURE_ANALYTICS=true

# CSoC E2E skill — regulator portal + auth
REGULATOR_ENVIRONMENT=tst
REGULATOR_PORTAL_BASE_URL=https://waste-packaging-regulators-fe.test.cdp-int.defra.cloud
REGULATOR_DASHBOARD_BASE_URL=https://waste-regulator-dashboard-fe.test.cdp-int.defra.cloud
REGULATOR_EMAIL_EA=replace-me@example.com
REGULATOR_EMAIL_NRW=replace-me@example.com
REGULATOR_EMAIL_SEPA=replace-me@example.com
REGULATOR_EMAIL_NIEA=replace-me@example.com
REGULATOR_PASSWORD_EA=replace-me
REGULATOR_PASSWORD_NRW=replace-me
REGULATOR_PASSWORD_SEPA=replace-me
REGULATOR_PASSWORD_NIEA=replace-me
REGULATOR_TESTS_PATH=/absolute/path/to/waste-packaging-regulator-tests

# mydw-e2e skill: tst PRN database (read-only) for the audit/CSV checks. Optional: without these the
# skill falls back to ../epr-playwright-bdd/features/ENV/.env.tst (DBSERVER/DBUSERNAME/DBPASSWORD).
# MYDW_TST_DB_SERVER=
# MYDW_TST_DB_USER=
# MYDW_TST_DB_PASSWORD=
# MYDW_TST_DB_NAME=tst1_prn
