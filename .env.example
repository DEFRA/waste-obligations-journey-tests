EPR_BASE_URL=https://localhost:7084

# B2C login + backend API credentials/org are picked by ENVIRONMENT:
#   ENVIRONMENT=dev → DEV_* vars
#   otherwise      → TST_* vars
DEV_EPR_USER_EMAIL=replace-me@example.com
DEV_EPR_USER_PASSWORD=replace-me
DEV_WASTE_OBLIGATION_USERNAME=replace-me
DEV_WASTE_OBLIGATION_PASSWORD=replace-me
DEV_WASTE_OBLIGATION_ORG_ID=replace-me
TST_EPR_USER_EMAIL=replace-me@example.com
TST_EPR_USER_PASSWORD=replace-me
TST_WASTE_OBLIGATION_USERNAME=replace-me
TST_WASTE_OBLIGATION_PASSWORD=replace-me
TST_WASTE_OBLIGATION_ORG_ID=replace-me

WASTE_OBLIGATION_SUBMITTER_ID=replace-me
WASTE_OBLIGATION_SUBMITTER_EMAIL=replace-me@example.com
