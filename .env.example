EPR_BASE_URL=https://localhost:7084
# packaging is the local default; CI uses waste-obligations.
JOURNEY_ENTRY_POINT=packaging
# Optional override for the lifecycle API; inferred from ENVIRONMENT otherwise.
# WASTE_OBLIGATIONS_API_BASE_URL=http://localhost:8007
EPR_USER_EMAIL=replace-me@example.com
EPR_USER_PASSWORD=replace-me
WASTE_OBLIGATION_USERNAME=replace-me
WASTE_OBLIGATION_PASSWORD=replace-me
JOURNEY_USER=replace-me
JOURNEY_PASSWORD=replace-me
WASTE_OBLIGATION_ORG_ID=replace-me
WASTE_OBLIGATION_SUBMITTER_ID=replace-me
WASTE_OBLIGATION_SUBMITTER_EMAIL=replace-me@example.com

# CSO account (used when ACCOUNT=cso)
EPR_CSO_USER_EMAIL=replace-me@example.com
EPR_CSO_USER_PASSWORD=replace-me
WASTE_OBLIGATION_CSO_ORG_ID=replace-me
