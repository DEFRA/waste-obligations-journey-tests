{
  "permissions": {
    "allow": [
      "Bash(node .claude/skills/jira-read/jira.mjs *)",
      "Bash(node .claude/skills/confluence-read/confluence.mjs *)",
      "Bash(node .claude/skills/qa-ticket/pr-status.mjs *)",
      "Bash(node .claude/skills/cdp-portal/cdp.mjs *)",
      "Bash(node .claude/install-control-plane.mjs *)",
      "Bash(node .claude/skills/review-tests/scan.mjs *)",
      "Bash(node .claude/skills/evidence-report/build-report.mjs *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(docker ps *)",
      "Bash(docker compose ps *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh search prs *)",
      "Bash(gh pr diff *)"
    ],
    "ask": [
      "Bash(node .claude/skills/jira-write/jira-write.mjs *)",
      "Bash(gh pr review *)",
      "Bash(gh pr comment *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.dev*)",
      "Read(**/.env.tst*)",
      "Read(**/.env.test*)",
      "Read(**/.env.pre*)",
      "Read(**/.env.prd*)",
      "Read(**/.env.prod*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/active-qa-session.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/install-control-plane.mjs\" check"
          }
        ]
      }
    ]
  }
}
