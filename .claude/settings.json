{
  "permissions": {
    "allow": [
      "Bash(node .claude/skills/jira-read/jira.mjs *)",
      "Bash(node .claude/skills/qa-ticket/pr-status.mjs *)",
      "Bash(node .claude/skills/evidence-report/build-report.mjs *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(docker ps *)",
      "Bash(docker compose ps *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh search prs *)"
    ],
    "ask": ["Bash(node .claude/skills/jira-write/jira-write.mjs *)"],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.dev*)",
      "Read(**/.env.tst*)",
      "Read(**/.env.test*)",
      "Read(**/.env.pre*)",
      "Read(**/.env.prd*)",
      "Read(**/.env.prod*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/active-qa-session.sh\""
          }
        ]
      }
    ]
  }
}
